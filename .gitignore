# Generated local data
__pycache__/
*.py[cod]

# Downloaded/local Piper voice models (the folder placeholder stays tracked)
piper/*
!piper/.gitkeep

# Legacy board-vision CNN dataset/assistant output
board_debug/
board_vision_assistant/

# Multi-model folder dataset: one folder per model under datasets/<model>/,
# each holding training/ and validation/ class folders. Git tracks only the
# default model's empty class-folder placeholders; dataset images, board
# crops/debug files, metadata and every other model stay local.
datasets/*
!datasets/default/
datasets/default/*
!datasets/default/training/
!datasets/default/validation/
datasets/default/training/*
!datasets/default/training/white_king/
!datasets/default/training/white_queen/
!datasets/default/training/white_rook/
!datasets/default/training/white_bishop/
!datasets/default/training/white_knight/
!datasets/default/training/white_pawn/
!datasets/default/training/black_king/
!datasets/default/training/black_queen/
!datasets/default/training/black_rook/
!datasets/default/training/black_bishop/
!datasets/default/training/black_knight/
!datasets/default/training/black_pawn/
!datasets/default/training/empty/
datasets/default/validation/*
!datasets/default/validation/white_king/
!datasets/default/validation/white_queen/
!datasets/default/validation/white_rook/
!datasets/default/validation/white_bishop/
!datasets/default/validation/white_knight/
!datasets/default/validation/white_pawn/
!datasets/default/validation/black_king/
!datasets/default/validation/black_queen/
!datasets/default/validation/black_rook/
!datasets/default/validation/black_bishop/
!datasets/default/validation/black_knight/
!datasets/default/validation/black_pawn/
!datasets/default/validation/empty/
datasets/default/training/*/*
!datasets/default/training/*/.gitkeep
datasets/default/validation/*/*
!datasets/default/validation/*/.gitkeep

# Exported CNN models: one <model>.pth per trained model. The folder
# placeholder is tracked; checkpoints stay local.
models/*
!models/.gitkeep

# Local engine training book and resumable frontier. Anchored to the
# repository root so `datasets/<model>/training/` placeholders stay tracked.
/training/
